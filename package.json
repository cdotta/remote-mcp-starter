{
  "name": "remote-mcp-starter",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "author": "crisis (https://github.com/cdotta)",
  "homepage": "https://github.com/cdotta/remote-mcp-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdotta/remote-mcp-starter.git"
  },
  "bugs": "https://github.com/cdotta/remote-mcp-starter/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "better-auth",
    "hono",
    "prisma",
    "starter-template"
  ],
  "type": "module",
  "description": "Production-grade remote MCP server template — Hono + Better Auth (PATs) + stateless Streamable HTTP.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.9",
    "@hono/node-server": "^1.13.8",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "better-auth": "^1.6.9",
    "dotenv": "^17.4.2",
    "hono": "^4.6.20",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^7.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
