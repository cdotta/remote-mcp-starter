# Postgres connection string. Matches the docker-compose service below
# (note the non-standard host port 5433 to avoid clashing with a local 5432).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mcp_starter?schema=public"

# Better Auth secret — used to sign session cookies and hash tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Public base URL of this server. Better Auth uses it to build callback URLs
# and to validate the Origin header on state-changing auth requests.
BETTER_AUTH_URL="http://localhost:3000"

# Port the Node server listens on.
PORT=3000
